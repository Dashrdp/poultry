# Copy to deploy/.env and fill in.

# Domain for Caddy (auto HTTPS). Use :80 for plain HTTP / IP-only smoke test.
SITE_ADDRESS=poultry.example.com

# Long random string (openssl rand -hex 32)
PF_SESSION_SECRET=change-me

# Postgres password (not the demo local default in production)
POSTGRES_PASSWORD=change-me

# 1 behind HTTPS (Caddy); 0 only for SITE_ADDRESS=:80 smoke tests
PF_HTTPS_ONLY=1

# Same-origin via Caddy needs no CORS. Leave empty, or set https://your.domain
PF_CORS_ORIGINS=

# TCP peers allowed to set X-Forwarded-* — must match deploy network subnet only.
# Do not use * or all of RFC1918. If compose subnet changes, change this too.
PF_TRUSTED_PROXIES=10.201.87.0/24
